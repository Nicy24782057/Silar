  {
    "sheet": "Narasi",
    "cell": "K10",
    "before": [
      "",
      false
    ],
    "after": [
      "Warga yang dievakuasi dilabeli OFFICER dan ditambahkan sebagai pihak. Evakuasi tidak membuktikan luka.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K11",
    "before": [
      "",
      false
    ],
    "after": [
      "Tidak ada korban adalah negasi korban. Banjir dan dampak pada tiga kios tetap dinyatakan terjadi.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K12",
    "before": [
      "",
      false
    ],
    "after": [
      "Saat latihan pertolongan dilabeli TIME. Banjir dinyatakan nyata. Waktu utama tetap siang tadi.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K13",
    "before": [
      "",
      false
    ],
    "after": [
      "Petugas desa menegaskan banjir terjadi. Air masuk dua toko adalah dampak literal yang disebut.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K14",
    "before": [
      "",
      false
    ],
    "after": [
      "Kematian seorang penjaga disebut setelah banjir. Tidak menambahkan mekanisme atau penyebab kematiannya.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K15",
    "before": [
      "",
      false
    ],
    "after": [
      "Wilayah di bukit dilabeli PLACE sebagai konteks pembanding. Lokasi banjir tetap Kampung Panyawangan yang disebut terdampak.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K16",
    "before": [
      "",
      false
    ],
    "after": [
      "Guncangan dan reaksi berlarian disebut eksplisit. Warga menjadi pihak, tanpa menyimpulkan korban luka.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K17",
    "before": [
      "",
      false
    ],
    "after": [
      "Dinding balai desa adalah objek yang roboh, bukan lokasi kejadian. Lokasi tetap Desa Kemuningasri.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K18",
    "before": [
      "",
      false
    ],
    "after": [
      "Tiga warga terluka dinyatakan eksplisit. Dampak, pihak dan span korban sesuai teks.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K19",
    "before": [
      "",
      false
    ],
    "after": [
      "Pergerakan sesar adalah penyebab eksplisit. Dua rumah dinyatakan rusak, tanpa menambah korban.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K20",
    "before": [
      "",
      false
    ],
    "after": [
      "Warga yang dievakuasi dilabeli OFFICER dan ditambahkan sebagai pihak. Tidak menyimpulkan luka.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K21",
    "before": [
      "",
      false
    ],
    "after": [
      "Tak ada korban jiwa menegasikan kematian, bukan gempa. Kerusakan pagar sekolah tetap dipertahankan.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K22",
    "before": [
      "",
      false
    ],
    "after": [
      "Penghentian latihan ditambahkan sebagai dampak dan INFORMATION karena dinyatakan akibat gempa sungguhan.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K23",
    "before": [
      "",
      false
    ],
    "after": [
      "Satu warung roboh dan satu pedagang meninggal disebut eksplisit. Tidak menambah pihak lain.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K24",
    "before": [
      "",
      false
    ],
    "after": [
      "Gempa dinyatakan terjadi dan merusak atap sekolah. Konteks video tidak mengubah label kejadian.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K25",
    "before": [
      "",
      false
    ],
    "after": [
      "Gempa susulan menjadi pemicu utuh. Terasa kuat dicatat literal. Mengungsi tidak menyatakan korban luka.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K26",
    "before": [
      "",
      false
    ],
    "after": [
      "Api merupakan pemicu kebakaran nyata karena menghanguskan dua kios. Tidak ada klaim korban.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K27",
    "before": [
      "",
      false
    ],
    "after": [
      "Kompor bocor merupakan penyebab eksplisit. Objek yang rusak adalah dapur sekolah.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K28",
    "before": [
      "",
      false
    ],
    "after": [
      "Dua pekerja terluka disebut eksplisit. Gudang Suryamurni merupakan lokasi, tanpa klaim kerusakan seluruh gudang.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K29",
    "before": [
      "",
      false
    ],
    "after": [
      "Petugas damkar dan tindakan pemadaman disebut eksplisit. Tidak menambahkan korban atau objek rusak.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K30",
    "before": [
      "",
      false
    ],
    "after": [
      "Satu rumah dinyatakan hangus. Frasa objek dan dampak pasif dipertahankan sesuai teks.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K31",
    "before": [
      "",
      false
    ],
    "after": [
      "Tidak ada korban adalah negasi korban, bukan penyangkalan kebakaran atau gudang yang hangus.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K32",
    "before": [
      "",
      false
    ],
    "after": [
      "Di tengah latihan damkar dilabeli TIME. Kebakaran dinyatakan nyata, dengan satu mobil rusak.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K33",
    "before": [
      "",
      false
    ],
    "after": [
      "Seorang penjaga meninggal dalam kebakaran disebut eksplisit. Tidak menambah jumlah korban.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K34",
    "before": [
      "",
      false
    ],
    "after": [
      "Klausa setelah titik dua menegaskan kebakaran benar-benar terjadi. Kabar palsu tidak menegasikan klaim itu.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K35",
    "before": [
      "",
      false
    ],
    "after": [
      "Korsleting listrik adalah penyebab eksplisit. Api melalap satu toko merupakan kejadian dan dampak nyata.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K36",
    "before": [
      "",
      false
    ],
    "after": [
      "Dua motor terlibat eksplisit. Tidak menebak jumlah pengendara atau kondisi korban.",
      false
    ]
  },
  {
    "sheet": "Narasi",
    "cell": "K37",
    "before": [
      "",
      false
    ],
    "after": [
      "Rem blong merupakan penyebab eksplisit. Satu bus dinyatakan rusak.",
      false
    ]
  },
