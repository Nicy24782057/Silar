    "probabilities": {
      "FLOOD": 1.8913455278379843e-05,
      "EARTHQUAKE": 1.554952177684754e-05,
      "FIRE": 0.9989449381828308,
      "ACCIDENT": 3.9856498915469274e-05,
      "NON_EVENT": 0.0009808256290853024
    }
  },
  {
    "id": "NEW07-FIRE-07",
    "text": "Asap pekat keluar dari rumah kosong, disusul nyala api yang melahap kusen dan atap; warga memanggil pemadam.",
