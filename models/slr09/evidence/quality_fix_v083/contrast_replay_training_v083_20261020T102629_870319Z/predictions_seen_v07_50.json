      "EARTHQUAKE": 1.2365604561637156e-05,
      "FIRE": 0.9976801872253418,
      "ACCIDENT": 3.2632167858537287e-05,
      "NON_EVENT": 0.0022584693506360054
    }
  },
  {
    "id": "NEW07-FIRE-10",
    "text": "Video ini tidak memakai api buatan. Kebakaran di garasi benar terjadi dan mobil di dalamnya hangus.",
