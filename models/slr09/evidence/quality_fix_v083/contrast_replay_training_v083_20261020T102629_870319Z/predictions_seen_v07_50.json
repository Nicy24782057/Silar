[
  {
    "id": "NEW07-FLOOD-01",
    "text": "Air banjir sudah setinggi pinggang di Gang Kelor sejak pukul enam dan keluarga kami mengungsi ke masjid.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9982162117958069,
      "EARTHQUAKE": 1.5519504813710228e-05,
      "FIRE": 1.2050129043927882e-05,
      "ACCIDENT": 2.6414274543640204e-05,
      "NON_EVENT": 0.0017298950115218759
    }
  },
  {
    "id": "NEW07-FLOOD-02",
    "text": "Hujan deras membuat Sungai Tawar meluap pagi ini; aliran air menggenangi puluhan rumah di bantaran.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9964590668678284,
      "EARTHQUAKE": 1.968985998246353e-05,
      "FIRE": 1.7870261217467487e-05,
      "ACCIDENT": 3.143455251120031e-05,
      "NON_EVENT": 0.003471923992037773
    }
  },
  {
    "id": "NEW07-FLOOD-03",
    "text": "Tidak seorang pun meninggal, meskipun banjir tadi malam menghancurkan tiga rumah di Dusun Papar.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9971222281455994,
      "EARTHQUAKE": 2.259337270515971e-05,
      "FIRE": 0.00010144813859369606,
      "ACCIDENT": 6.014594328007661e-05,
      "NON_EVENT": 0.0026936179492622614
    }
  },
  {
    "id": "NEW07-FLOOD-04",
    "text": "Petugas sedang berlatih menolong korban gempa ketika air banjir betulan menerobos tempat latihan dan mereka harus pindah.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9979660511016846,
      "EARTHQUAKE": 2.4619734176667407e-05,
      "FIRE": 1.1077463568653911e-05,
      "ACCIDENT": 3.4985725505976006e-05,
      "NON_EVENT": 0.001963332062587142
    }
  },
  {
    "id": "NEW07-FLOOD-05",
    "text": "Foto permukiman terendam itu sempat disebut palsu. Relawan di lokasi memastikan banjir benar terjadi dan membawa warga keluar.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.995101273059845,
      "EARTHQUAKE": 5.894603964406997e-05,
      "FIRE": 8.273965249827597e-06,
      "ACCIDENT": 7.698739500483498e-05,
      "NON_EVENT": 0.0047544571571052074
    }
  },
  {
    "id": "NEW07-FLOOD-06",
    "text": "Rumah di bukit tidak kebanjiran, tetapi rumah kami di bantaran sungai sudah terendam dan kami menunggu perahu.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9587846398353577,
      "EARTHQUAKE": 8.139780220517423e-06,
      "FIRE": 5.241604594630189e-05,
      "ACCIDENT": 0.00010438063327455893,
      "NON_EVENT": 0.041050396859645844
    }
  },
  {
    "id": "NEW07-FLOOD-07",
    "text": "Tanggul di belakang pasar runtuh sore ini. Air sungai masuk ke deretan toko hingga dagangan hanyut dan pedagang mengungsi.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9960166811943054,
      "EARTHQUAKE": 5.809618960483931e-05,
      "FIRE": 0.0003272784233558923,
      "ACCIDENT": 0.00011309683759463951,
      "NON_EVENT": 0.003484842600300908
    }
  },
  {
    "id": "NEW07-FLOOD-08",
    "text": "Yang dilaporkan bukan kemungkinan pekan depan. Banjir sudah masuk ke puskesmas hari ini dan pasien dipindahkan.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9956706762313843,
      "EARTHQUAKE": 1.5098121366463602e-05,
      "FIRE": 3.0344524930114858e-05,
      "ACCIDENT": 4.39740288129542e-05,
      "NON_EVENT": 0.00423994567245245
    }
  },
  {
    "id": "NEW07-FLOOD-09",
    "text": "Kabar gempa di kampung kami salah. Justru banjir yang sedang terjadi, dengan jalan dan halaman rumah tergenang.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9829952120780945,
      "EARTHQUAKE": 7.932163862278685e-05,
      "FIRE": 0.00010485705570317805,
      "ACCIDENT": 7.400009053526446e-05,
      "NON_EVENT": 0.016746588051319122
    }
  },
  {
    "id": "NEW07-FLOOD-10",
    "text": "Gambar banjir di layar ini bukan cuplikan sinetron; siaran langsung memperlihatkan petugas mengevakuasi warga dari rumah terendam.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9828158020973206,
      "EARTHQUAKE": 2.9326951334951445e-05,
      "FIRE": 5.3131294407648966e-05,
      "ACCIDENT": 8.651929965708405e-05,
      "NON_EVENT": 0.017015365883708
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-01",
    "text": "Gempa terasa kuat di Kecamatan Tegalreja siang ini, membuat warga keluar dan menyebabkan tembok toko retak.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.00014896031643729657,
      "EARTHQUAKE": 0.9984246492385864,
      "FIRE": 2.3338385290117003e-05,
      "ACCIDENT": 3.932574691134505e-05,
      "NON_EVENT": 0.0013637400697916746
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-02",
    "text": "Guncangan gempa menjatuhkan genting balai desa pukul 04.20; petugas masih memeriksa bangunan.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.00010177330113947392,
      "EARTHQUAKE": 0.9986977577209473,
      "FIRE": 1.6229821994784288e-05,
      "ACCIDENT": 7.637850649189204e-05,
      "NON_EVENT": 0.001107853720895946
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-03",
    "text": "Tidak ditemukan korban cedera setelah gempa mengguncang Desa Manggala dan merusak dinding dua sekolah.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.0001702116132946685,
      "EARTHQUAKE": 0.9976307153701782,
      "FIRE": 1.5701256415923126e-05,
      "ACCIDENT": 9.686958946986124e-05,
      "NON_EVENT": 0.0020864810794591904
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-04",
    "text": "Latihan menghadapi banjir mendadak berhenti. Tanah benar-benar berguncang akibat gempa dan peserta keluar dari gedung.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 7.203408313216642e-05,
      "EARTHQUAKE": 0.9990000128746033,
      "FIRE": 5.472778502735309e-05,
      "ACCIDENT": 4.078695201314986e-05,
      "NON_EVENT": 0.0008324161753989756
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-05",
    "text": "Pengumuman pertama dianggap gurauan, lalu seismolog dan warga membenarkan gempa baru terjadi serta merusak pagar rumah.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 5.462130138766952e-05,
      "EARTHQUAKE": 0.9989226460456848,
      "FIRE": 4.116140917176381e-05,
      "ACCIDENT": 4.444209480425343e-05,
      "NON_EVENT": 0.0009370389161631465
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-06",
    "text": "Laporan ini bukan tentang gempa susulan. Gempa awal pukul satu tadi telah merobohkan atap sebuah rumah.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 3.743987690540962e-05,
      "EARTHQUAKE": 0.998746395111084,
      "FIRE": 2.412376670690719e-05,
      "ACCIDENT": 4.029846240882762e-05,
      "NON_EVENT": 0.0011517649982124567
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-07",
    "text": "Lantai bergetar hebat, lampu gantung bergoyang dan dinding retak bersamaan di seluruh kampung. Badan geofisika mengonfirmasi guncangan tektonik.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 8.812378655420616e-05,
      "EARTHQUAKE": 0.9988401532173157,
      "FIRE": 5.917242742725648e-05,
      "ACCIDENT": 3.213729723938741e-05,
      "NON_EVENT": 0.0009803762659430504
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-08",
    "text": "Petugas tidak sedang meramalkan gempa. Mereka melaporkan gempa yang baru saja mengguncang kota dan memecahkan kaca kantor.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.00012188222899567336,
      "EARTHQUAKE": 0.999001681804657,
      "FIRE": 3.153219950036146e-05,
      "ACCIDENT": 5.3234471124596894e-05,
      "NON_EVENT": 0.0007917655748315156
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-09",
    "text": "Bunyi keras itu bukan tabrakan di jalan. Gempa sedang mengguncang gedung kami hingga plafonnya jatuh.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 4.268933116691187e-05,
      "EARTHQUAKE": 0.9987658262252808,
      "FIRE": 7.112965249689296e-05,
      "ACCIDENT": 0.00014950442709960043,
      "NON_EVENT": 0.0009708150755614042
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-10",
    "text": "Kami tidak sedang menonton efek film. Gempa sungguhan menggoyang studio dan seluruh kru berlari ke halaman.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 5.767180482507683e-05,
      "EARTHQUAKE": 0.9987762570381165,
      "FIRE": 3.6574620025930926e-05,
      "ACCIDENT": 0.00011270031973253936,
      "NON_EVENT": 0.0010167837608605623
    }
  },
  {
    "id": "NEW07-FIRE-01",
    "text": "Warung di samping bengkel Jalan Pulasan kebakaran pagi ini; kobaran api merambat ke dua atap di sebelahnya.",
