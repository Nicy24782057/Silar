      "EARTHQUAKE": 0.0001176033474621363,
      "FIRE": 0.9959264993667603,
      "ACCIDENT": 0.0006783526623621583,
      "NON_EVENT": 0.003201659768819809
    }
  },
  {
    "id": "NEW07-FIRE-06",
    "text": "Bukan gudang kayu yang terbakar. Kebakaran terjadi di rumah sebelahnya dan petugas sedang menyemprot ruang tamu.",
