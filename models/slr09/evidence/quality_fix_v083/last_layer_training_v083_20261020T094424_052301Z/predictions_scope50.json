      "FIRE": 0.00011060178803745657,
      "ACCIDENT": 0.00010947891132673249,
      "NON_EVENT": 0.03737366572022438
    }
  },
  {
    "id": "NEW06-FLOOD-06",
    "text": "Tanggul jebol barusan; air sungai meluap melewati jendela rumah dan warga naik ke atap.",
