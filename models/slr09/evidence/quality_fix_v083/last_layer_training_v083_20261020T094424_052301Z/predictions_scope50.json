      "FIRE": 0.0001191771516459994,
      "ACCIDENT": 0.00010089567513205111,
      "NON_EVENT": 0.0034655085764825344
    }
  },
  {
    "id": "NEW06-FLOOD-07",
    "text": "Tidak ada kebakaran di pasar. Yang terjadi adalah banjir, dengan air setinggi lutut para pedagang.",
