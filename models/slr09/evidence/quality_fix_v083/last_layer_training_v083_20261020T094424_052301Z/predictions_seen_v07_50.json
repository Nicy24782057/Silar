      "EARTHQUAKE": 3.4699121897574514e-05,
      "FIRE": 6.135109288152307e-05,
      "ACCIDENT": 8.556795364711434e-05,
      "NON_EVENT": 0.007179523818194866
    }
  },
  {
    "id": "NEW07-FLOOD-09",
    "text": "Kabar gempa di kampung kami salah. Justru banjir yang sedang terjadi, dengan jalan dan halaman rumah tergenang.",
