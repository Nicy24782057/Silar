    "probabilities": {
      "FLOOD": 0.9809972047805786,
      "EARTHQUAKE": 2.324962588318158e-05,
      "FIRE": 5.532715658773668e-05,
      "ACCIDENT": 0.00019022349442820996,
      "NON_EVENT": 0.018734008073806763
    }
  },
  {
    "id": "NEW07-FLOOD-07",
    "text": "Tanggul di belakang pasar runtuh sore ini. Air sungai masuk ke deretan toko hingga dagangan hanyut dan pedagang mengungsi.",
