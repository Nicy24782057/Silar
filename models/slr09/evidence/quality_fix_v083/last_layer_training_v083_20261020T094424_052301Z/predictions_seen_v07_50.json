      "EARTHQUAKE": 0.0001501291844760999,
      "FIRE": 0.0004268580232746899,
      "ACCIDENT": 0.00025531137362122536,
      "NON_EVENT": 0.002713211113587022
    }
  },
  {
    "id": "NEW07-FLOOD-08",
    "text": "Yang dilaporkan bukan kemungkinan pekan depan. Banjir sudah masuk ke puskesmas hari ini dan pasien dipindahkan.",
