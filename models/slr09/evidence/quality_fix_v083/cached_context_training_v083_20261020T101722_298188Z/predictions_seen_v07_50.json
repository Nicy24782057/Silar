[
  {
    "id": "NEW07-FLOOD-01",
    "text": "Air banjir sudah setinggi pinggang di Gang Kelor sejak pukul enam dan keluarga kami mengungsi ke masjid.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9984719157218933,
      "EARTHQUAKE": 2.3416005205945112e-05,
      "FIRE": 1.2146059816586785e-05,
      "ACCIDENT": 2.6023602913483046e-05,
      "NON_EVENT": 0.0014664552873000503
    }
  },
  {
    "id": "NEW07-FLOOD-02",
    "text": "Hujan deras membuat Sungai Tawar meluap pagi ini; aliran air menggenangi puluhan rumah di bantaran.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9979752898216248,
      "EARTHQUAKE": 2.9665074180229567e-05,
      "FIRE": 1.640565460547805e-05,
      "ACCIDENT": 3.851942892652005e-05,
      "NON_EVENT": 0.0019400914898142219
    }
  },
  {
    "id": "NEW07-FLOOD-03",
    "text": "Tidak seorang pun meninggal, meskipun banjir tadi malam menghancurkan tiga rumah di Dusun Papar.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9982777833938599,
      "EARTHQUAKE": 3.438380372244865e-05,
      "FIRE": 8.185298065654933e-05,
      "ACCIDENT": 7.858583558117971e-05,
      "NON_EVENT": 0.0015274332836270332
    }
  },
  {
    "id": "NEW07-FLOOD-04",
    "text": "Petugas sedang berlatih menolong korban gempa ketika air banjir betulan menerobos tempat latihan dan mereka harus pindah.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9982926249504089,
      "EARTHQUAKE": 3.385620584595017e-05,
      "FIRE": 1.2066243471053895e-05,
      "ACCIDENT": 3.406855103094131e-05,
      "NON_EVENT": 0.0016275258967652917
    }
  },
  {
    "id": "NEW07-FLOOD-05",
    "text": "Foto permukiman terendam itu sempat disebut palsu. Relawan di lokasi memastikan banjir benar terjadi dan membawa warga keluar.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9972068667411804,
      "EARTHQUAKE": 8.446975698461756e-05,
      "FIRE": 8.669340786582325e-06,
      "ACCIDENT": 7.526586705353111e-05,
      "NON_EVENT": 0.0026246628258377314
    }
  },
  {
    "id": "NEW07-FLOOD-06",
    "text": "Rumah di bukit tidak kebanjiran, tetapi rumah kami di bantaran sungai sudah terendam dan kami menunggu perahu.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9914121627807617,
      "EARTHQUAKE": 1.1691579857142642e-05,
      "FIRE": 2.827060416166205e-05,
      "ACCIDENT": 7.397068839054555e-05,
      "NON_EVENT": 0.008473942056298256
    }
  },
  {
    "id": "NEW07-FLOOD-07",
    "text": "Tanggul di belakang pasar runtuh sore ini. Air sungai masuk ke deretan toko hingga dagangan hanyut dan pedagang mengungsi.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.99764484167099,
      "EARTHQUAKE": 6.828930781921372e-05,
      "FIRE": 0.00020671167294494808,
      "ACCIDENT": 0.00010569918231340125,
      "NON_EVENT": 0.001974447863176465
    }
  },
  {
    "id": "NEW07-FLOOD-08",
    "text": "Yang dilaporkan bukan kemungkinan pekan depan. Banjir sudah masuk ke puskesmas hari ini dan pasien dipindahkan.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9971374273300171,
      "EARTHQUAKE": 2.1643723812303506e-05,
      "FIRE": 2.669983405212406e-05,
      "ACCIDENT": 4.030728086945601e-05,
      "NON_EVENT": 0.002773890271782875
    }
  },
  {
    "id": "NEW07-FLOOD-09",
    "text": "Kabar gempa di kampung kami salah. Justru banjir yang sedang terjadi, dengan jalan dan halaman rumah tergenang.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9930358529090881,
      "EARTHQUAKE": 7.748216739855707e-05,
      "FIRE": 6.382858555298299e-05,
      "ACCIDENT": 7.323610770981759e-05,
      "NON_EVENT": 0.006749478634446859
    }
  },
  {
    "id": "NEW07-FLOOD-10",
    "text": "Gambar banjir di layar ini bukan cuplikan sinetron; siaran langsung memperlihatkan petugas mengevakuasi warga dari rumah terendam.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9946783781051636,
      "EARTHQUAKE": 3.770989860640839e-05,
      "FIRE": 3.375229789526202e-05,
      "ACCIDENT": 6.355373625410721e-05,
      "NON_EVENT": 0.005186593160033226
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-01",
    "text": "Gempa terasa kuat di Kecamatan Tegalreja siang ini, membuat warga keluar dan menyebabkan tembok toko retak.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.00019703357247635722,
      "EARTHQUAKE": 0.9982948899269104,
      "FIRE": 4.326169437263161e-05,
      "ACCIDENT": 5.700950350728817e-05,
      "NON_EVENT": 0.0014077676460146904
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-02",
    "text": "Guncangan gempa menjatuhkan genting balai desa pukul 04.20; petugas masih memeriksa bangunan.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.00012446488835848868,
      "EARTHQUAKE": 0.998664379119873,
      "FIRE": 2.90043080894975e-05,
      "ACCIDENT": 0.00010724939784267917,
      "NON_EVENT": 0.0010749243665486574
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-03",
    "text": "Tidak ditemukan korban cedera setelah gempa mengguncang Desa Manggala dan merusak dinding dua sekolah.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.00019228222663514316,
      "EARTHQUAKE": 0.9978079199790955,
      "FIRE": 2.7025045710615814e-05,
      "ACCIDENT": 0.0001215031006722711,
      "NON_EVENT": 0.0018513314425945282
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-04",
    "text": "Latihan menghadapi banjir mendadak berhenti. Tanah benar-benar berguncang akibat gempa dan peserta keluar dari gedung.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.00011816118785645813,
      "EARTHQUAKE": 0.9978156089782715,
      "FIRE": 0.0001261793659068644,
      "ACCIDENT": 4.9942686018766835e-05,
      "NON_EVENT": 0.0018901563016697764
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-05",
    "text": "Pengumuman pertama dianggap gurauan, lalu seismolog dan warga membenarkan gempa baru terjadi serta merusak pagar rumah.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 6.012519952491857e-05,
      "EARTHQUAKE": 0.9981309771537781,
      "FIRE": 7.659600669285282e-05,
      "ACCIDENT": 4.563757102005184e-05,
      "NON_EVENT": 0.001686652540229261
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-06",
    "text": "Laporan ini bukan tentang gempa susulan. Gempa awal pukul satu tadi telah merobohkan atap sebuah rumah.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 4.6929268137319013e-05,
      "EARTHQUAKE": 0.9984336495399475,
      "FIRE": 4.6642948291264474e-05,
      "ACCIDENT": 4.827123848372139e-05,
      "NON_EVENT": 0.0014244592748582363
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-07",
    "text": "Lantai bergetar hebat, lampu gantung bergoyang dan dinding retak bersamaan di seluruh kampung. Badan geofisika mengonfirmasi guncangan tektonik.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.000135251902975142,
      "EARTHQUAKE": 0.9985585808753967,
      "FIRE": 0.0001294616231461987,
      "ACCIDENT": 4.9556747399037704e-05,
      "NON_EVENT": 0.0011272105621173978
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-08",
    "text": "Petugas tidak sedang meramalkan gempa. Mereka melaporkan gempa yang baru saja mengguncang kota dan memecahkan kaca kantor.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 0.00014913226186763495,
      "EARTHQUAKE": 0.9984320998191833,
      "FIRE": 6.009786739014089e-05,
      "ACCIDENT": 5.8654273743741214e-05,
      "NON_EVENT": 0.0012999909231439233
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-09",
    "text": "Bunyi keras itu bukan tabrakan di jalan. Gempa sedang mengguncang gedung kami hingga plafonnya jatuh.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 5.595699985860847e-05,
      "EARTHQUAKE": 0.9982981085777283,
      "FIRE": 0.0001762548490660265,
      "ACCIDENT": 0.00026127201272174716,
      "NON_EVENT": 0.0012084782356396317
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-10",
    "text": "Kami tidak sedang menonton efek film. Gempa sungguhan menggoyang studio dan seluruh kru berlari ke halaman.",
