      "EARTHQUAKE": 6.571190676873103e-05,
      "FIRE": 0.00015215167286756595,
      "ACCIDENT": 0.00041244137259070996,
      "NON_EVENT": 0.10770193676420219
    }
  },
  {
    "id": "NEW07-FLOOD-07",
    "text": "Tanggul di belakang pasar runtuh sore ini. Air sungai masuk ke deretan toko hingga dagangan hanyut dan pedagang mengungsi.",
