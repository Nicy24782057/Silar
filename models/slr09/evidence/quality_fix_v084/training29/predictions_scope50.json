      "ACCIDENT": 8.89239163370803e-05,
      "NON_EVENT": 0.0001823260827222839
    }
  },
  {
    "id": "NEW06-EARTHQUAKE-07",
    "text": "Bukan kecelakaan kendaraan yang membuat warga keluar. Gempa sedang mengguncang kawasan perumahan.",
