      "FIRE": 0.999681830406189,
      "ACCIDENT": 1.5067653293954208e-05,
      "NON_EVENT": 0.00027858669636771083
    }
  },
  {
    "id": "NEW07-FIRE-03",
    "text": "Kebakaran menghanguskan kandang di Desa Sidamukti, tetapi seluruh pekerja selamat dan tidak ada korban luka.",
