      "FIRE": 0.9997720122337341,
      "ACCIDENT": 9.42122824199032e-06,
      "NON_EVENT": 0.00020556210074573755
    }
  },
  {
    "id": "NEW07-FIRE-02",
    "text": "Api membakar ruang penyimpanan pasar sejak tadi malam dan tiga mobil pemadam masih berusaha memadamkannya.",
