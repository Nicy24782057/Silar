[
  {
    "id": "NEW07-FLOOD-01",
    "text": "Air banjir sudah setinggi pinggang di Gang Kelor sejak pukul enam dan keluarga kami mengungsi ke masjid.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9996860027313232,
      "EARTHQUAKE": 1.2261351002962328e-05,
      "FIRE": 6.093472165957792e-06,
      "ACCIDENT": 1.8046306649921462e-05,
      "NON_EVENT": 0.00027765161939896643
    }
  },
  {
    "id": "NEW07-FLOOD-02",
    "text": "Hujan deras membuat Sungai Tawar meluap pagi ini; aliran air menggenangi puluhan rumah di bantaran.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9994350075721741,
      "EARTHQUAKE": 1.4032079889148008e-05,
      "FIRE": 8.468785381410271e-06,
      "ACCIDENT": 1.8530898159951903e-05,
      "NON_EVENT": 0.0005238829762674868
    }
  },
  {
    "id": "NEW07-FLOOD-03",
    "text": "Tidak seorang pun meninggal, meskipun banjir tadi malam menghancurkan tiga rumah di Dusun Papar.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9993844032287598,
      "EARTHQUAKE": 1.7342264982289635e-05,
      "FIRE": 6.470651715062559e-05,
      "ACCIDENT": 4.110839654458687e-05,
      "NON_EVENT": 0.0004924274398945272
    }
  },
  {
    "id": "NEW07-FLOOD-04",
    "text": "Petugas sedang berlatih menolong korban gempa ketika air banjir betulan menerobos tempat latihan dan mereka harus pindah.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9996196031570435,
      "EARTHQUAKE": 1.897079164336901e-05,
      "FIRE": 5.7112897593469825e-06,
      "ACCIDENT": 2.3812568542780355e-05,
      "NON_EVENT": 0.00033191946567967534
    }
  },
  {
    "id": "NEW07-FLOOD-05",
    "text": "Foto permukiman terendam itu sempat disebut palsu. Relawan di lokasi memastikan banjir benar terjadi dan membawa warga keluar.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9990862607955933,
      "EARTHQUAKE": 6.269639561651275e-05,
      "FIRE": 4.572660145640839e-06,
      "ACCIDENT": 5.778281411039643e-05,
      "NON_EVENT": 0.0007888515829108655
    }
  },
  {
    "id": "NEW07-FLOOD-06",
    "text": "Rumah di bukit tidak kebanjiran, tetapi rumah kami di bantaran sungai sudah terendam dan kami menunggu perahu.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9710347652435303,
      "EARTHQUAKE": 4.602874469128437e-06,
      "FIRE": 5.1819537475239486e-05,
      "ACCIDENT": 0.00010355139238527045,
      "NON_EVENT": 0.028805166482925415
    }
  },
  {
    "id": "NEW07-FLOOD-07",
    "text": "Tanggul di belakang pasar runtuh sore ini. Air sungai masuk ke deretan toko hingga dagangan hanyut dan pedagang mengungsi.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.998928964138031,
      "EARTHQUAKE": 5.202419561101124e-05,
      "FIRE": 0.00025936373276636004,
      "ACCIDENT": 9.339641110273078e-05,
      "NON_EVENT": 0.0006662447704002261
    }
  },
  {
    "id": "NEW07-FLOOD-08",
    "text": "Yang dilaporkan bukan kemungkinan pekan depan. Banjir sudah masuk ke puskesmas hari ini dan pasien dipindahkan.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9990345239639282,
      "EARTHQUAKE": 1.0547232704993803e-05,
      "FIRE": 1.7810994904721156e-05,
      "ACCIDENT": 2.8796868718927726e-05,
      "NON_EVENT": 0.0009081576718017459
    }
  },
  {
    "id": "NEW07-FLOOD-09",
    "text": "Kabar gempa di kampung kami salah. Justru banjir yang sedang terjadi, dengan jalan dan halaman rumah tergenang.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9928088188171387,
      "EARTHQUAKE": 7.727343472652137e-05,
      "FIRE": 0.00010535346518736333,
      "ACCIDENT": 5.9554295148700476e-05,
      "NON_EVENT": 0.006949050351977348
    }
  },
  {
    "id": "NEW07-FLOOD-10",
    "text": "Gambar banjir di layar ini bukan cuplikan sinetron; siaran langsung memperlihatkan petugas mengevakuasi warga dari rumah terendam.",
    "gold": "FLOOD",
    "probabilities": {
      "FLOOD": 0.9944937825202942,
      "EARTHQUAKE": 2.2516222088597715e-05,
      "FIRE": 4.2537878471193835e-05,
      "ACCIDENT": 7.042849028948694e-05,
      "NON_EVENT": 0.005370742175728083
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-01",
    "text": "Gempa terasa kuat di Kecamatan Tegalreja siang ini, membuat warga keluar dan menyebabkan tembok toko retak.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 7.290362555067986e-05,
      "EARTHQUAKE": 0.9997871518135071,
      "FIRE": 7.54643906475394e-06,
      "ACCIDENT": 1.3146258424967527e-05,
      "NON_EVENT": 0.00011926214210689068
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-02",
    "text": "Guncangan gempa menjatuhkan genting balai desa pukul 04.20; petugas masih memeriksa bangunan.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 4.700407225755043e-05,
      "EARTHQUAKE": 0.9998173117637634,
      "FIRE": 4.974559942638734e-06,
      "ACCIDENT": 2.491990744601935e-05,
      "NON_EVENT": 0.0001058100096997805
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-03",
    "text": "Tidak ditemukan korban cedera setelah gempa mengguncang Desa Manggala dan merusak dinding dua sekolah.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 8.114618685794994e-05,
      "EARTHQUAKE": 0.9997214674949646,
      "FIRE": 4.742480086861178e-06,
      "ACCIDENT": 3.331258994876407e-05,
      "NON_EVENT": 0.00015921902377158403
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-04",
    "text": "Latihan menghadapi banjir mendadak berhenti. Tanah benar-benar berguncang akibat gempa dan peserta keluar dari gedung.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 3.0023833460290916e-05,
      "EARTHQUAKE": 0.9998339414596558,
      "FIRE": 2.165495061490219e-05,
      "ACCIDENT": 1.5605926819262095e-05,
      "NON_EVENT": 9.874175884760916e-05
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-05",
    "text": "Pengumuman pertama dianggap gurauan, lalu seismolog dan warga membenarkan gempa baru terjadi serta merusak pagar rumah.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 2.7423460778663866e-05,
      "EARTHQUAKE": 0.999850869178772,
      "FIRE": 1.4768685105082113e-05,
      "ACCIDENT": 1.72330310306279e-05,
      "NON_EVENT": 8.964176231529564e-05
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-06",
    "text": "Laporan ini bukan tentang gempa susulan. Gempa awal pukul satu tadi telah merobohkan atap sebuah rumah.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 1.7310096154687926e-05,
      "EARTHQUAKE": 0.9998534917831421,
      "FIRE": 7.629546416865196e-06,
      "ACCIDENT": 1.3645933904626872e-05,
      "NON_EVENT": 0.00010804272460518405
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-07",
    "text": "Lantai bergetar hebat, lampu gantung bergoyang dan dinding retak bersamaan di seluruh kampung. Badan geofisika mengonfirmasi guncangan tektonik.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 3.861369623336941e-05,
      "EARTHQUAKE": 0.9998272061347961,
      "FIRE": 1.9925688320654444e-05,
      "ACCIDENT": 1.0865182957786601e-05,
      "NON_EVENT": 0.00010350543743697926
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-08",
    "text": "Petugas tidak sedang meramalkan gempa. Mereka melaporkan gempa yang baru saja mengguncang kota dan memecahkan kaca kantor.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 5.630699888570234e-05,
      "EARTHQUAKE": 0.9998341798782349,
      "FIRE": 1.071984752343269e-05,
      "ACCIDENT": 1.9142260498483665e-05,
      "NON_EVENT": 7.957017078297213e-05
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-09",
    "text": "Bunyi keras itu bukan tabrakan di jalan. Gempa sedang mengguncang gedung kami hingga plafonnya jatuh.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 1.9851760953315534e-05,
      "EARTHQUAKE": 0.9998065829277039,
      "FIRE": 2.4348089937120676e-05,
      "ACCIDENT": 5.118617991684005e-05,
      "NON_EVENT": 9.803095599636436e-05
    }
  },
  {
    "id": "NEW07-EARTHQUAKE-10",
    "text": "Kami tidak sedang menonton efek film. Gempa sungguhan menggoyang studio dan seluruh kru berlari ke halaman.",
    "gold": "EARTHQUAKE",
    "probabilities": {
      "FLOOD": 2.8104162993258797e-05,
      "EARTHQUAKE": 0.9998249411582947,
      "FIRE": 1.2291424354771152e-05,
      "ACCIDENT": 4.010097836726345e-05,
      "NON_EVENT": 9.459102875553071e-05
    }
  },
  {
    "id": "NEW07-FIRE-01",
    "text": "Warung di samping bengkel Jalan Pulasan kebakaran pagi ini; kobaran api merambat ke dua atap di sebelahnya.",
