    "probabilities": {
      "FLOOD": 7.99137615103973e-06,
      "EARTHQUAKE": 6.825321634096326e-06,
      "FIRE": 0.9998032450675964,
      "ACCIDENT": 1.739396611810662e-05,
      "NON_EVENT": 0.00016455537115689367
    }
  },
  {
    "id": "NEW07-FIRE-07",
    "text": "Asap pekat keluar dari rumah kosong, disusul nyala api yang melahap kusen dan atap; warga memanggil pemadam.",
