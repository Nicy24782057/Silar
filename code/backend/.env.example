# Salin menjadi .env dan ganti setiap CHANGE_ME. setup_local.py membuat nilai acak.
SILAR_LOCAL_MODE=true
DEBUG=true
SECRET_KEY=CHANGE_ME
JWT_SIGNING_KEY=CHANGE_ME
OTP_HMAC_KEY=CHANGE_ME
DB_NAME=silar_local
DB_USER=silar_app
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
FRONTEND_VERIFY_PATH=/verify-email
FRONTEND_ACTIVATE_PATH=/activate-operator
FRONTEND_RESET_PATH=/reset-password
# file: email lokal ditulis hanya ke private_outbox; tidak dikirim lewat internet.
EMAIL_MODE=file
DEFAULT_FROM_EMAIL=SILAR Lokal <noreply@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_SEND_LIMIT=5
OTP_WINDOW_SECONDS=900
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ANALYSIS_CAPACITY=1

# SLR11: local model directories default to model_assets/sena, nara, whisper-small.
# Optional path overrides: MODEL_ASSET_ROOT, SILAR_SLR09_ROOT,
# SENA_MODEL_DIR, NARA_MODEL_DIR, WHISPER_MODEL_DIR.
WHISPER_VARIANT=small
AI_CPU_THREADS=2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=90000
GEMINI_MAX_OUTPUT_TOKENS=4096
# Initial deadline; must be measured with the target server/proxy/client.
ANALYSIS_DEADLINE_SECONDS=240
