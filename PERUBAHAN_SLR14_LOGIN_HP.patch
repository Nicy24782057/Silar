+@keyframes review-gesture { 0%,30%,100%{transform:rotate(0deg)} 55%,70%{transform:rotate(5deg)} }
+@keyframes review-emphasis { 0%,100%{fill:#E8F5FC} 50%{fill:#D5F0F8} }
+@keyframes water-light { 0%,100%{opacity:.55} 50%{opacity:1} }
