+.evidence-photo { animation:evidence-float 7s ease-in-out infinite; }
+.evidence-text { animation:evidence-float 8s ease-in-out -2s infinite; }
+.evidence-audio { animation:evidence-float 6.5s ease-in-out -3s infinite; }
+.report-device { animation:device-float 7.5s ease-in-out -1s infinite; }
+.review-card { animation:evidence-float 8s ease-in-out -4s infinite; }
+.privacy-token { animation:evidence-float 6s ease-in-out -2.5s infinite; }
+.evidence-flow { stroke-dasharray:3 9; animation:evidence-flow 8s linear infinite; }
+.audio-bar { transform-box:fill-box; transform-origin:center; animation:audio-signal 1.9s ease-in-out infinite; }
+.reviewing-arm { transform-origin:12px 18px; animation:review-gesture 8s ease-in-out infinite; }
+.review-emphasis { animation:review-emphasis 6s ease-in-out infinite; }
+.water-ripple { animation:water-light 4s ease-in-out infinite; }
+@keyframes evidence-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-7px)} }
